# Copy to Backend/.env. Blank keys leave optional services disabled.
# Environment variables take precedence. AVSAR_ENV_FILE can point to another file.
GEMINI_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Optional. Blank = persistent local SQLite in Backend/data.
MONGO_URI=
# auto uses MongoDB when configured; sqlite keeps integrations on with local storage.
DATABASE_BACKEND=auto
USE_LOCAL_DB=false
LOCAL_DB_FALLBACK=true
LOCAL_DB_PATH=

# Discovery Engine: livescout (Unstop + Devpost + Remotive + Arbeitnow + RSS) works reliably without Yutori.
SCOUT_PROVIDER=livescout
ENABLE_YUTORI=false
# Yutori is optional legacy fallback.
YUTORI_KEY=
NGROK_BASE_URL=
YUTORI_WEBHOOK_SECRET=
# Leave blank for authenticated polling. A WhatsApp-only gateway does NOT expose Yutori callbacks.
YUTORI_WEBHOOK_BASE_URL=

# Meta WhatsApp Cloud API
# Optional account identifiers for read-only setup diagnostics.
WHATSAPP_APP_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=opptrax_verify_token
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0

# Approved authentication template with body OTP and copy-code URL button.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Approved Hindi utility template body: {{1}} title, {{2}} date, {{3}} URL.
# Required for proactive messages outside the customer service window.
WHATSAPP_REMINDER_TEMPLATE_NAME=
# Optional approved alert templates for each preference. Body parameters:
# {{1}} opportunity title, {{2}} short notification text, {{3}} source URL.
# HI must use locale hi. EN and BOTH must use en_US (BOTH has bilingual text).
# Required to send discovery/reminder alerts outside the 24-hour reply window.
WHATSAPP_ALERT_TEMPLATE_HI=
WHATSAPP_ALERT_TEMPLATE_EN=
WHATSAPP_ALERT_TEMPLATE_BOTH=

# Optional Twilio WhatsApp fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Web Auth, CORS & Background Workers
AUTH_SECRET=change-this-to-a-random-secret-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=true
ENABLE_BACKGROUND_TASKS=true
